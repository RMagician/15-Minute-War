<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site root for the game's domain. Needs URL Rewrite + ARR proxy enabled. Port must match serve.ps1. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="15MW proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8015/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
